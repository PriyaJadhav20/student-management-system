# Copy to .env (never commit .env) or set these in your hosting dashboard.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: creates this admin on startup if it doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Optional
# DATABASE_URL=sqlite:///database.db
# SESSION_COOKIE_SECURE=1   # set to 1 when served over HTTPS
# FLASK_DEBUG=1             # local development only
